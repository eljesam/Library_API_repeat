@page "/"

@inject HttpClient Http

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<p class="text-muted">
	Welcome to Bibliotech
</p>

@if (isLoading)
{
	<p>Loading Dashboard...</p>

}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
	<div class="alert alert-danger">
		@errorMessage
	</div>
}
else
{
	<div class="dashoard-grid">

		<div class="dashboard-card">
			<h3>Authors</h3>
			<p>@authorCount</p>
		</div>

		<div class="dashboard-card">
			<h3>Books</h3>
			<p>@bookCount</p>
		</div>

		<div class="dashboard-card">
			<h3>Members</h3>
			<p>@memberCount</p>
		</div>

		<div class="dashboard-card">
			<h3>Loans</h3>
			<p>@loanCount</p>
		</div>

	
	</div>
}

@code
{
	private int authorCount;
	private int bookCount;
	private int memberCount;
	private int loanCount;

	private bool isLoading = true;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			authorCount = await GetCount("/api/authors");
			bookCount = await GetCount("/api/books");
			memberCount = await GetCount("/api/members");
			loanCount = await GetCount("/api/loans");
		}
		catch
		{
			errorMessage = "Unable to load dashboard data.";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task<int> GetCount(string endpoint)
	{
		var response = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>(endpoint);

		return response.GetArrayLength();
	}
}