@page "/loans"

@using System.Net.Http.Json
@using Library_API_repeat.Client.Models.Loans
@using Library_API_repeat.Client.Models.Books
@using Library_API_repeat.Client.Models.Members
@using Library_API_repeat.Client.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationService AuthenticationService

<PageTitle>Loans</PageTitle>

<div class="page-header">
    <div>
        <h1>
            @(AuthenticationService.IsAdmin ? "Loans" : "My Loans")
        </h1>

        <p class="text-muted">
            @(AuthenticationService.IsAdmin
                ? "Manage library loans."
                : "View your library loans.")
        </p>
    </div>

    @if (AuthenticationService.IsAdmin)
    {
        <button class="btn btn-primary"
                @onclick="ShowAddForm">
            Add Loan
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (AuthenticationService.IsAdmin && showAddForm)
{
    <div class="card p-4 mb-4">

        <h4>Add Loan</h4>

        <EditForm Model="@newLoan"
                  OnValidSubmit="@AddLoan">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Book</label>

                <InputSelect class="form-select"
                             @bind-Value="newLoan.BookId">

                    <option value="0">
                        Select a book
                    </option>

                    @foreach (var book in books)
                    {
                        if (book.IsAvailable)
                        {
                            <option value="@book.Id">
                                @book.Title - @book.AuthorName
                            </option>
                        }
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Member</label>

                <InputSelect class="form-select"
                             @bind-Value="newLoan.MemberId">

                    <option value="0">
                        Select a member
                    </option>

                    @foreach (var member in members)
                    {
                        <option value="@member.Id">
                            @member.Name (@member.Email)
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Loan Date
                </label>

                <InputDate class="form-control"
                           @bind-Value="newLoan.LoanDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Due Date
                </label>

                <InputDate class="form-control"
                           @bind-Value="newLoan.DueDate" />
            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Save
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelAdd">
                Cancel
            </button>

        </EditForm>
    </div>
}

@if (AuthenticationService.IsAdmin && showEditForm)
{
    <div class="card p-4 mb-4">

        <h4>Edit Loan</h4>

        <EditForm Model="@editLoan"
                  OnValidSubmit="@UpdateLoan">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Book</label>

                <InputSelect class="form-select"
                             @bind-Value="editLoan.BookId">

                    @foreach (var book in books)
                    {
                        <option value="@book.Id">
                            @book.Title - @book.AuthorName
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Member</label>

                <InputSelect class="form-select"
                             @bind-Value="editLoan.MemberId">

                    @foreach (var member in members)
                    {
                        <option value="@member.Id">
                            @member.Name (@member.Email)
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Loan Date
                </label>

                <InputDate class="form-control"
                           @bind-Value="editLoan.LoanDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Due Date
                </label>

                <InputDate class="form-control"
                           @bind-Value="editLoan.DueDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Return Date
                </label>

                <InputDate TValue="DateTime?"
                           class="form-control"
                           @bind-Value="editLoan.ReturnDate" />
            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Save Changes
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelEdit">
                Cancel
            </button>

        </EditForm>
    </div>
}

@if (isLoading)
{
    <p>Loading loans...</p>
}
else if (loans.Count == 0)
{
    <div class="alert alert-info">
        No loans found.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>
                <tr>
                    <th>Book</th>

                    @if (AuthenticationService.IsAdmin)
                    {
                        <th>Member</th>
                    }

                    <th>Loan Date</th>
                    <th>Due Date</th>
                    <th>Returned</th>
                    <th>Status</th>

                    @if (AuthenticationService.IsAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>

                @foreach (var loan in loans)
                {
                    <tr>
                        <td>@loan.BookTitle</td>

                        @if (AuthenticationService.IsAdmin)
                        {
                            <td>@loan.MemberName</td>
                        }

                        <td>
                            @loan.LoanDate.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @loan.DueDate.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @(loan.ReturnDate.HasValue
                                ? loan.ReturnDate.Value.ToString("dd MMM yyyy")
                                : "-")
                        </td>

                        <td>
                            @if (loan.ReturnDate.HasValue)
                            {
                                <span class="badge bg-success">
                                    Returned
                                </span>
                            }
                            else if (loan.DueDate.Date < DateTime.Today)
                            {
                                <span class="badge bg-danger">
                                    Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    Active
                                </span>
                            }
                        </td>

                        @if (AuthenticationService.IsAdmin)
                        {
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => ShowEditForm(loan)">
                                    Edit
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteLoan(loan)">
                                    Delete
                                </button>
                            </td>
                        }
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code
{
    private List<Loan> loans = new();

    private List<Book> books = new();

    private List<Member> members = new();

    private CreateLoanRequest newLoan = new();

    private UpdateLoanRequest editLoan = new();

    private int editingLoanId;

    private bool showAddForm;

    private bool showEditForm;

    private bool isLoading = true;

    private string? errorMessage;

    private string? successMessage;


    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationService.IsAdmin)
        {
            await LoadAdminData();
        }
        else
        {
            await LoadMyLoans();
        }
    }


    private async Task LoadAdminData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            loans =
                await Http.GetFromJsonAsync<List<Loan>>(
                    "/api/loans")
                ?? new List<Loan>();

            books =
                await Http.GetFromJsonAsync<List<Book>>(
                    "/api/books")
                ?? new List<Book>();

            members =
                await Http.GetFromJsonAsync<List<Member>>(
                    "/api/members")
                ?? new List<Member>();
        }
        catch
        {
            errorMessage =
                "Unable to load loan data.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadMyLoans()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            loans =
                await Http.GetFromJsonAsync<List<Loan>>(
                    "/api/loans/my")
                ?? new List<Loan>();
        }
        catch
        {
            errorMessage =
                "Unable to load your loans.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task RefreshLoans()
    {
        if (AuthenticationService.IsAdmin)
        {
            loans =
                await Http.GetFromJsonAsync<List<Loan>>(
                    "/api/loans")
                ?? new List<Loan>();
        }
        else
        {
            await LoadMyLoans();
        }
    }


    private void ShowAddForm()
    {
        newLoan = new CreateLoanRequest
        {
            LoanDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(14)
        };

        showAddForm = true;
        showEditForm = false;

        errorMessage = null;
        successMessage = null;
    }


    private void CancelAdd()
    {
        showAddForm = false;

        newLoan = new CreateLoanRequest();
    }


    private async Task AddLoan()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var response =
                await Http.PostAsJsonAsync(
                    "/api/loans",
                    newLoan);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Unable to create loan.";

                return;
            }

            showAddForm = false;

            newLoan = new CreateLoanRequest();

            successMessage =
                "Loan created successfully.";

            await LoadAdminData();
        }
        catch
        {
            errorMessage =
                "Unable to create loan.";
        }
    }


    private void ShowEditForm(Loan loan)
    {
        editingLoanId = loan.Id;

        editLoan = new UpdateLoanRequest
        {
            BookId = loan.BookId,
            MemberId = loan.MemberId,
            LoanDate = loan.LoanDate,
            DueDate = loan.DueDate,
            ReturnDate = loan.ReturnDate
        };

        showEditForm = true;
        showAddForm = false;

        errorMessage = null;
        successMessage = null;
    }


    private void CancelEdit()
    {
        showEditForm = false;

        editingLoanId = 0;

        editLoan = new UpdateLoanRequest();
    }


    private async Task UpdateLoan()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var response =
                await Http.PutAsJsonAsync(
                    $"/api/loans/{editingLoanId}",
                    editLoan);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Unable to update loan.";

                return;
            }

            showEditForm = false;

            editingLoanId = 0;

            editLoan = new UpdateLoanRequest();

            successMessage =
                "Loan updated successfully.";

            await LoadAdminData();
        }
        catch
        {
            errorMessage =
                "Unable to update loan.";
        }
    }


    private async Task DeleteLoan(Loan loan)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Delete the loan for {loan.BookTitle}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            var response =
                await Http.DeleteAsync(
                    $"/api/loans/{loan.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Unable to delete loan.";

                return;
            }

            successMessage =
                "Loan deleted successfully.";

            await LoadAdminData();
        }
        catch
        {
            errorMessage =
                "Unable to delete loan.";
        }
    }
}
