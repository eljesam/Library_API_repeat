@page "/books"

@using System.Net.Http.Json
@using Library_API_repeat.Client.Models.Books
@using Library_API_repeat.Client.Models.Authors

@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Books</PageTitle>

<div class="page-header">
    <div>
        <h1>Books</h1>
        <p class="text-muted">
            Manage books in the library.
        </p>
    </div>

    <button class="btn btn-primary"
            @onclick="ShowAddForm">
        Add Book
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (showAddForm)
{
    <div class="card p-4 mb-4">
        <h4>Add Book</h4>

        <EditForm Model="@newBook"
                  OnValidSubmit="@AddBook">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Title</label>

                <InputText class="form-control"
                           @bind-Value="newBook.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">ISBN</label>

                <InputText class="form-control"
                           @bind-Value="newBook.ISBN" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Publication Year
                </label>

                <InputNumber class="form-control"
                             @bind-Value="newBook.PublicationYear" />
            </div>

            <div class="mb-3">
                <label class="form-label">Author</label>

                <InputSelect class="form-select"
                             @bind-Value="newBook.AuthorId">

                    <option value="0">
                        Select an author
                    </option>

                    @foreach (var author in authors)
                    {
                        <option value="@author.Id">
                            @author.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input"
                               @bind-Value="newBook.IsAvailable" />

                <label class="form-check-label">
                    Available
                </label>
            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Save
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelAdd">
                Cancel
            </button>

        </EditForm>
    </div>
}

@if (showEditForm)
{
    <div class="card p-4 mb-4">
        <h4>Edit Book</h4>

        <EditForm Model="@editBook"
                  OnValidSubmit="@UpdateBook">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Title</label>

                <InputText class="form-control"
                           @bind-Value="editBook.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">ISBN</label>

                <InputText class="form-control"
                           @bind-Value="editBook.ISBN" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Publication Year
                </label>

                <InputNumber class="form-control"
                             @bind-Value="editBook.PublicationYear" />
            </div>

            <div class="mb-3">
                <label class="form-label">Author</label>

                <InputSelect class="form-select"
                             @bind-Value="editBook.AuthorId">

                    <option value="0">
                        Select an author
                    </option>

                    @foreach (var author in authors)
                    {
                        <option value="@author.Id">
                            @author.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input"
                               @bind-Value="editBook.IsAvailable" />

                <label class="form-check-label">
                    Available
                </label>
            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Save Changes
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelEdit">
                Cancel
            </button>

        </EditForm>
    </div>
}

@if (isLoading)
{
    <p>Loading books...</p>
}
else if (books.Count == 0)
{
    <div class="alert alert-info">
        No books have been added yet.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>ISBN</th>
                    <th>Year</th>
                    <th>Author</th>
                    <th>Availability</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var book in books)
                {
                    <tr>
                        <td>@book.Id</td>

                        <td>@book.Title</td>

                        <td>@book.ISBN</td>

                        <td>@book.PublicationYear</td>

                        <td>@book.AuthorName</td>

                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    On Loan
                                </span>
                            }
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-primary me-2"
                                    @onclick="() => ShowEditForm(book)">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteBook(book)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<Book> books = new();

    private List<Author> authors = new();

    private CreateBookRequest newBook = new();

    private UpdateBookRequest editBook = new();

    private bool showAddForm;

    private bool showEditForm;

    private bool isLoading = true;

    private int editingBookId;

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var bookResult =
                await Http.GetFromJsonAsync<List<Book>>(
                    "/api/books");

            var authorResult =
                await Http.GetFromJsonAsync<List<Author>>(
                    "/api/authors");

            books = bookResult ?? new List<Book>();

            authors = authorResult ?? new List<Author>();
        }
        catch
        {
            errorMessage =
                "Unable to load book data.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadBooks()
    {
        try
        {
            var result =
                await Http.GetFromJsonAsync<List<Book>>(
                    "/api/books");

            books = result ?? new List<Book>();
        }
        catch
        {
            errorMessage =
                "Unable to load books.";
        }
    }


    private void ShowAddForm()
    {
        newBook = new CreateBookRequest
        {
            IsAvailable = true
        };

        showAddForm = true;
        showEditForm = false;

        errorMessage = null;
    }


    private void CancelAdd()
    {
        showAddForm = false;

        newBook = new CreateBookRequest
        {
            IsAvailable = true
        };
    }


    private async Task AddBook()
    {
        try
        {
            errorMessage = null;

            var response =
                await Http.PostAsJsonAsync(
                    "/api/books",
                    newBook);

            if (response.IsSuccessStatusCode)
            {
                showAddForm = false;

                newBook = new CreateBookRequest
                {
                    IsAvailable = true
                };

                await LoadBooks();
            }
            else
            {
                errorMessage =
                    "Unable to add book.";
            }
        }
        catch
        {
            errorMessage =
                "Unable to add book.";
        }
    }


    private void ShowEditForm(Book book)
    {
        editingBookId = book.Id;

        editBook = new UpdateBookRequest
        {
            Title = book.Title,
            ISBN = book.ISBN,
            PublicationYear = book.PublicationYear,
            IsAvailable = book.IsAvailable,
            AuthorId = book.AuthorId
        };

        showEditForm = true;
        showAddForm = false;

        errorMessage = null;
    }


    private void CancelEdit()
    {
        showEditForm = false;

        editingBookId = 0;

        editBook = new UpdateBookRequest();
    }


    private async Task UpdateBook()
    {
        try
        {
            errorMessage = null;

            var response =
                await Http.PutAsJsonAsync(
                    $"/api/books/{editingBookId}",
                    editBook);

            if (response.IsSuccessStatusCode)
            {
                showEditForm = false;

                editingBookId = 0;

                editBook = new UpdateBookRequest();

                await LoadBooks();
            }
            else
            {
                errorMessage =
                    "Unable to update book.";
            }
        }
        catch
        {
            errorMessage =
                "Unable to update book.";
        }
    }


    private async Task DeleteBook(Book book)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Are you sure you want to delete {book.Title}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;

            var response =
                await Http.DeleteAsync(
                    $"/api/books/{book.Id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadBooks();
            }
            else
            {
                errorMessage =
                    "Unable to delete book. It may be associated with an existing loan.";
            }
        }
        catch
        {
            errorMessage =
                "Unable to delete book.";
        }
    }
}
