@page "/members"

@using System.Net.Http.Json
@using Library_API_repeat.Client.Models.Members
@using Library_API_repeat.Client.Models.Auth
@using Library_API_repeat.Client.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationService AuthenticationService
@inject NavigationManager Navigation

<PageTitle>Members</PageTitle>

<div class="page-header">
    <div>
        <h1>Members</h1>

        <p class="text-muted">
            Manage registered library members.
        </p>
    </div>

    <button class="btn btn-primary"
            @onclick="ShowRegisterForm">
        Register New Member
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (showRegisterForm)
{
    <div class="card p-4 mb-4">

        <h4>Register New Member</h4>

        <EditForm Model="@registerRequest"
                  OnValidSubmit="@RegisterMember">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">
                    Name
                </label>

                <InputText class="form-control"
                           @bind-Value="registerRequest.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <InputText class="form-control"
                           @bind-Value="registerRequest.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Password
                </label>

                <InputText class="form-control"
                           type="password"
                           @bind-Value="registerRequest.Password" />
            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Register Member
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelRegister">
                Cancel
            </button>

        </EditForm>

    </div>
}

@if (showEditForm)
{
    <div class="card p-4 mb-4">

        <h4>Edit Membership</h4>

        <p class="text-muted">
            @editingMemberName
        </p>

        <EditForm Model="@editMember"
                  OnValidSubmit="@UpdateMember">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">

                <label class="form-label">
                    Membership Date
                </label>

                <InputDate class="form-control"
                           @bind-Value="editMember.MembershipDate" />

            </div>

            <button type="submit"
                    class="btn btn-success me-2">
                Save Changes
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelEdit">
                Cancel
            </button>

        </EditForm>

    </div>
}

@if (isLoading)
{
    <p>Loading members...</p>
}
else if (members.Count == 0)
{
    <div class="alert alert-info">
        No members found.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Membership Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var member in members)
                {
                    <tr>

                        <td>
                            @member.Id
                        </td>

                        <td>
                            @member.Name
                        </td>

                        <td>
                            @member.Email
                        </td>

                        <td>
                            @member.MembershipDate.ToString("dd MMM yyyy")
                        </td>

                        <td>

                            <button class="btn btn-sm btn-outline-primary me-2"
                                    @onclick="() => ShowEditForm(member)">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteMember(member)">
                                Delete
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    private List<Member> members = new();

    private RegisterRequest registerRequest = new();

    private UpdateMemberRequest editMember = new();

    private int editingMemberId;

    private string editingMemberName = string.Empty;

    private bool showRegisterForm;

    private bool showEditForm;

    private bool isLoading = true;

    private string? errorMessage;

    private string? successMessage;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthenticationService.IsAdmin)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadMembers();
    }


    private async Task LoadMembers()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var result =
                await Http.GetFromJsonAsync<List<Member>>(
                    "/api/members");

            members =
                result ?? new List<Member>();
        }
        catch
        {
            errorMessage =
                "Unable to load members.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void ShowRegisterForm()
    {
        registerRequest =
            new RegisterRequest();

        showRegisterForm = true;
        showEditForm = false;

        errorMessage = null;
        successMessage = null;
    }


    private void CancelRegister()
    {
        showRegisterForm = false;

        registerRequest =
            new RegisterRequest();
    }


    private async Task RegisterMember()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var success =
                await AuthenticationService.RegisterAsync(
                    registerRequest);

            if (!success)
            {
                errorMessage =
                    "Unable to register member. The email may already be in use.";

                return;
            }

            showRegisterForm = false;

            registerRequest =
                new RegisterRequest();

            successMessage =
                "Member registered successfully.";

            await LoadMembers();
        }
        catch
        {
            errorMessage =
                "Unable to register member.";
        }
    }


    private void ShowEditForm(Member member)
    {
        editingMemberId = member.Id;

        editingMemberName = member.Name;

        editMember =
            new UpdateMemberRequest
            {
                MembershipDate =
                    member.MembershipDate
            };

        showEditForm = true;
        showRegisterForm = false;

        errorMessage = null;
        successMessage = null;
    }


    private void CancelEdit()
    {
        showEditForm = false;

        editingMemberId = 0;
        editingMemberName = string.Empty;

        editMember =
            new UpdateMemberRequest();
    }


    private async Task UpdateMember()
    {
        try
        {
            errorMessage = null;
            successMessage = null;

            var response =
                await Http.PutAsJsonAsync(
                    $"/api/members/{editingMemberId}",
                    editMember);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Unable to update member.";

                return;
            }

            showEditForm = false;

            editingMemberId = 0;
            editingMemberName = string.Empty;

            editMember =
                new UpdateMemberRequest();

            successMessage =
                "Member updated successfully.";

            await LoadMembers();
        }
        catch
        {
            errorMessage =
                "Unable to update member.";
        }
    }


    private async Task DeleteMember(Member member)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Are you sure you want to delete {member.Name}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            var response =
                await Http.DeleteAsync(
                    $"/api/members/{member.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    "Unable to delete member. The member may have existing loans.";

                return;
            }

            successMessage =
                "Member deleted successfully.";

            await LoadMembers();
        }
        catch
        {
            errorMessage =
                "Unable to delete member.";
        }
    }
}
